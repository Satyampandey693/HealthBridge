PORT=5001
NODE_ENV=DEVELOPMENT

# Database. If your MongoDB has authentication enabled (e.g. the Docker mongo
# image started with MONGO_INITDB_ROOT_USERNAME/PASSWORD), include credentials
# and authSource=admin:
#   mongodb://<user>:<pass>@127.0.0.1:27017/HealthBridge?authSource=admin
DB_LOCAL_URI=mongodb://127.0.0.1:27017/HealthBridge
DB_URI=mongodb://127.0.0.1:27017/HealthBridge

# Frontend origin (used for CORS + reset-password links)
FRONTEND_URL=http://localhost:5173

# Public base URL of this backend (used to build static photo URLs)
# Note: port 5000 is taken by macOS AirPlay Receiver, so we use 5001.
BACKEND_URL=http://localhost:5001

# Auth secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRE_TIME=7d
COOKIE_EXPIRES_TIME=7

# Razorpay test/live API keys from your Razorpay dashboard
RAZORPAY_API_KEY=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_API_SECRET=your_razorpay_secret
